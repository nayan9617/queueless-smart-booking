PORT=5001
MONGO_URI=mongodb://localhost:27017/queueless
JWT_SECRET=change-me
CLIENT_URL=http://localhost:5173
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-password
ML_SERVICE_URL=http://localhost:8000
DB_NAME=queueless
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
PENDING_BOOKING_TTL_MINUTES=20

# Runtime: local | beta | production
# beta/production IGNORES the three dangerous flags below even if set true.
APP_ENV=local

# Founder beta snapshot: GET /api/ops/beta-stats with header x-beta-ops-key
BETA_OPS_SECRET=

# Extra frontend origins (comma-separated), e.g. https://queueless-web.vercel.app
CORS_ORIGINS=

# Vercel Cron: GET /api/ops/expire-pending with Authorization: Bearer CRON_SECRET
CRON_SECRET=

# --- DANGEROUS — local/E2E only. Never true in a real-user beta. ---
# Default all false. Local Playwright/dev may set them true.
ALLOW_DEMO_PAY=false
ALLOW_TEST_EMAIL_VERIFY=false
DISABLE_RATE_LIMIT=false
