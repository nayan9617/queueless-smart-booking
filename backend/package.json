{
  "name": "queueless-backend",
  "version": "1.0.0",
  "description": "Backend service for QueueLess Smart Booking System",
  "main": "src/app.ts",
  "scripts": {
    "start": "node dist/app.js",
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "seed": "tsx src/scripts/seedSalons.ts",
    "seed:beta": "tsx src/scripts/seedBetaSalons.ts",
    "test": "tsx --test --test-force-exit \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@types/nodemailer": "^7.0.9",
    "axios": "^1.13.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "^11.0.2",
    "helmet": "^7.1.0",
    "http-status": "^1.7.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "nodemailer": "^8.0.1",
    "razorpay": "^2.9.8",
    "socket.io": "^4.7.2",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.56.0",
    "nodemon": "^3.0.2",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  }
}
